# Go to Supabase Dashboard -> Project Settings -> API to find these.
# SUPABASE_SERVICE_KEY is the `service_role` key (server-side only, never expose to the client).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Secret used to sign our own session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# 32-byte hex key used to AES-256-GCM encrypt stored credentials (AI keys, DB strings).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=change-me-to-a-64-char-hex-string

# Optional: base URL of an OpenAI-compatible API used for AI-key connection tests.
# AI_BASE_URL=https://api.openai.com/v1/models

PORT=4000